# Server Configuration
PORT=8080

# PostgreSQL (Neon Cloud)
DB_HOST=your-neon-host.postgres.database.azure.com
DB_USER=your_db_user
DB_PASSWORD=your_db_password
DB_NAME=gorisk_db
DB_PORT=5432
DB_SSLMODE=require

# MongoDB Atlas
MONGO_URI=mongodb+srv://user:password@cluster.mongodb.net/gorisk_db

# Redis (Upstash)
REDIS_HOST=your-redis-host.upstash.io:6379
REDIS_PASSWORD=your_redis_password

# Gemini AI Engine
GEMINI_API_KEY=your_gemini_api_key_here

# Kafka Broker
KAFKA_BROKER=localhost:9092